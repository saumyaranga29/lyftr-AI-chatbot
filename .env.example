# Comma-separated key pool, at least 2 keys. Key ids are key_1, key_2, ... in this order.
LLM_API_KEYS=your_first_api_key_here,your_second_api_key_here

# SQLite location (e.g. sqlite:////data/app.db inside Docker or sqlite:///./app.db locally)
DATABASE_URL=sqlite:////data/app.db

# Comma-separated CORS origins allowed to access the backend
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://your-frontend-deployment.vercel.app

# Set to true to enable the X-Simulate-Failure test hook
ENABLE_FAILURE_SIMULATION=true

# Model name supported by LiteLLM (e.g. gemini/gemini-2.0-flash, gpt-4o-mini, groq/llama-3.1-8b-instant)
LLM_MODEL=gemini/gemini-2.0-flash

# Frontend environment variable pointing to the backend API base URL
VITE_API_URL=http://localhost:8000
